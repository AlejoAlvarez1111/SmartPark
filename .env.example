NODE_ENV=development

# Puertos de cada proceso
GATEWAY_PORT=3000
VEHICLES_PORT=3001
SPACES_PORT=3002
RESERVATIONS_PORT=3003
SENSORS_PORT=3004

# URLs entre servicios (en Docker Compose se sobrescriben con los nombres de contenedor)
VEHICLES_SERVICE_URL=http://localhost:3001
SPACES_SERVICE_URL=http://localhost:3002
RESERVATIONS_SERVICE_URL=http://localhost:3003
SENSORS_SERVICE_URL=http://localhost:3004
SERVICE_TIMEOUT_MS=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=smartpark_user
DB_PASSWORD=change_me
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change_me_root
VEHICLES_DB=smartpark_vehicles
SPACES_DB=smartpark_spaces
RESERVATIONS_DB=smartpark_reservations
SENSORS_DB=smartpark_sensors

# Una reserva marca el espacio como RESERVADO desde N minutos antes de empezar
RESERVATION_HOLD_MINUTES=60
# Tolerancia para aceptar una reserva cuyo inicio ya pasó (minutos)
RESERVATION_PAST_TOLERANCE_MINUTES=5
# Reenvío de eventos de reserva a spaces-service: cada cuánto y cuántos intentos como máximo
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5

# El frontend lo sirve el gateway; este origen extra se permite por CORS
FRONTEND_ORIGIN=http://localhost:5500
